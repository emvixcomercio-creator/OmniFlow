// =============================================================================
//  OmniFlow — Atendimento Omnichannel
//  PostgreSQL + Prisma
//  npx prisma migrate dev --name init
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------ enums ---

enum Role {
  ADMIN
  SUPERVISOR
  AGENT
}

enum UserStatus {
  ONLINE
  BUSY
  AWAY
  OFFLINE
}

enum ChannelType {
  WHATSAPP
  INSTAGRAM
  WEBCHAT
}

enum ChannelProvider {
  EVOLUTION        // WhatsApp via Evolution API
  WHATSAPP_CLOUD   // WhatsApp Cloud API (Meta)
  INSTAGRAM_GRAPH  // Instagram Messaging (Graph API)
  WEBCHAT          // widget próprio
}

enum TicketStatus {
  BOT       // em triagem automática
  WAITING   // na fila do departamento
  OPEN      // em atendimento humano
  RESOLVED  // finalizado
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AuthorType {
  CONTACT
  AGENT
  BOT
  SYSTEM
}

enum MessageKind {
  TEXT
  IMAGE
  FILE
  AUDIO
  VIDEO
  LOCATION
  EVENT     // log de transferência / atribuição / encerramento
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

// ----------------------------------------------------------------- models ---

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  passwordHash  String
  avatarUrl     String?
  role          Role       @default(AGENT)
  status        UserStatus @default(OFFLINE)
  maxConcurrent Int        @default(5)
  active        Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments   DepartmentMember[]
  tickets       Ticket[]           @relation("TicketAssignee")
  messages      Message[]          @relation("MessageAgent")
  notes         Note[]
  transfersFrom TicketTransfer[]   @relation("TransferBy")
  transfersTo   TicketTransfer[]   @relation("TransferToUser")

  @@index([role, active])
  @@map("users")
}

model Department {
  id         String  @id @default(cuid())
  name       String  @unique
  slug       String  @unique
  color      String  @default("#2547eb")
  slaMinutes Int     @default(10)
  autoAssign Boolean @default(true)
  active     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   DepartmentMember[]
  tickets   Ticket[]
  transfers TicketTransfer[]   @relation("TransferToDepartment")
  botOption BotMenuOption[]

  @@map("departments")
}

/// Tabela de junção User <-> Department (um atendente pode servir vários setores).
model DepartmentMember {
  id           String @id @default(cuid())
  userId       String
  departmentId String

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@map("department_members")
}

model Channel {
  id         String          @id @default(cuid())
  name       String
  type       ChannelType
  provider   ChannelProvider
  /// Número, ig_id ou domínio do site.
  identifier String
  /// Credenciais/config do provedor (token, instância, phoneNumberId…).
  config     Json?
  active     Boolean         @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets  Ticket[]
  contacts ContactChannel[]

  @@unique([provider, identifier])
  @@map("channels")
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  company   String?
  city      String?
  avatarUrl String?
  document  String?
  notes     String?
  tags      String[] @default([])
  /// Campos livres do CRM.
  metadata  Json?
  blocked   Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channels ContactChannel[]
  tickets  Ticket[]

  @@index([phone])
  @@index([email])
  @@map("contacts")
}

/// Identidade do contato em cada canal (mesmo cliente no WhatsApp e no Instagram).
model ContactChannel {
  id         String  @id @default(cuid())
  contactId  String
  channelId  String
  /// wa_id (5511999999999), IGSID do Instagram ou sessionId do webchat.
  externalId String
  handle     String?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, externalId])
  @@index([contactId])
  @@map("contact_channels")
}

model Ticket {
  id       String @id @default(cuid())
  /// Protocolo sequencial exibido ao cliente (#1042).
  protocol String @unique

  contactId    String
  channelId    String
  departmentId String?
  assigneeId   String?

  status   TicketStatus @default(BOT)
  priority Priority     @default(NORMAL)
  subject  String?
  tags     String[]     @default([])
  rating   Int?
  feedback String?

  createdAt       DateTime  @default(now())
  /// Momento em que o bot entregou o chamado para a fila humana.
  queuedAt        DateTime?
  assignedAt      DateTime?
  firstResponseAt DateTime?
  closedAt        DateTime?
  lastActivityAt  DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  contact    Contact          @relation(fields: [contactId], references: [id])
  channel    Channel          @relation(fields: [channelId], references: [id])
  department Department?      @relation(fields: [departmentId], references: [id])
  assignee   User?            @relation("TicketAssignee", fields: [assigneeId], references: [id])
  messages   Message[]
  internal   Note[]
  transfers  TicketTransfer[]
  botSession BotSession?

  @@index([status, departmentId])
  @@index([assigneeId, status])
  @@index([channelId, createdAt])
  @@index([contactId, createdAt])
  @@map("tickets")
}

model Message {
  id       String @id @default(cuid())
  ticketId String

  authorType AuthorType
  /// Preenchido apenas quando authorType = AGENT.
  agentId    String?

  direction MessageDirection
  kind      MessageKind      @default(TEXT)
  body      String           @db.Text

  mediaUrl  String?
  mediaName String?
  mediaMime String?
  mediaSize Int?

  /// ID da mensagem no provedor (wamid.xxx, mid.xxx) — evita duplicidade no webhook.
  externalId String?        @unique
  status     DeliveryStatus @default(PENDING)
  /// Payload cru recebido do provedor, útil para auditoria e replay.
  raw        Json?

  createdAt   DateTime  @default(now())
  deliveredAt DateTime?
  readAt      DateTime?

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  agent  User?  @relation("MessageAgent", fields: [agentId], references: [id])

  @@index([ticketId, createdAt])
  @@map("messages")
}

/// Nota interna: visível apenas para a equipe, nunca enviada ao cliente.
model Note {
  id       String @id @default(cuid())
  ticketId String
  authorId String
  body     String @db.Text
  /// Marca a nota como aviso destacado para o próximo atendente.
  pinned   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
  @@map("notes")
}

/// Log de cada transferência entre setores/atendentes (auditoria + métricas).
model TicketTransfer {
  id       String @id @default(cuid())
  ticketId String

  fromDepartmentId String?
  toDepartmentId   String
  fromUserId       String?
  toUserId         String?
  byUserId         String
  reason           String?

  createdAt DateTime @default(now())

  ticket       Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  toDepartment Department @relation("TransferToDepartment", fields: [toDepartmentId], references: [id])
  toUser       User?      @relation("TransferToUser", fields: [toUserId], references: [id])
  by           User       @relation("TransferBy", fields: [byUserId], references: [id])

  @@index([ticketId, createdAt])
  @@map("ticket_transfers")
}

/// Estado do bot de triagem para um ticket (qual nó do menu está ativo).
model BotSession {
  id        String   @id @default(cuid())
  ticketId  String   @unique
  step      String   @default("MENU_ROOT")
  attempts  Int      @default(0)
  answers   Json?
  finished  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("bot_sessions")
}

/// Opções configuráveis do menu de triagem (editáveis pelo gestor).
model BotMenuOption {
  id           String  @id @default(cuid())
  key          String
  label        String
  departmentId String
  subject      String?
  order        Int     @default(0)
  active       Boolean @default(true)

  department Department @relation(fields: [departmentId], references: [id])

  @@unique([key])
  @@map("bot_menu_options")
}

/// Respostas rápidas / macros usadas pelos atendentes.
model QuickReply {
  id           String  @id @default(cuid())
  title        String
  body         String  @db.Text
  departmentId String?
  shortcut     String?

  createdAt DateTime @default(now())

  @@map("quick_replies")
}
